# agy-proxy 配置 —— 所有脚本 source 此文件
# ============================================

# 代理监听端口
PROXY_PORT=18080

# 推理后端: anthropic-vertex | openai
AGY_BACKEND=anthropic-vertex

# --- anthropic-vertex 后端(Claude on Vertex AI,ADC 认证)---
CLAUDE_PROJECT=<your-gcp-project>
CLAUDE_REGION=global
CLAUDE_MODEL=claude-opus-4-8

# --- openai 后端(任意 OpenAI 兼容 endpoint)---
# 默认指向本地 mock(start.sh 会在 BACKEND=openai 时自动拉起 mock)
#
# 接入示例 — Kimi (Moonshot):
#   AGY_BACKEND=openai
#   OPENAI_BASE_URL=https://api.moonshot.cn/v1      # 国际版: api.moonshot.ai
#   OPENAI_API_KEY=sk-xxxx
#   NEW_MODEL_ID=<用 GET /v1/models 查最新型号,如 kimi-k2-0711-preview>
# 接入示例 — 自部署 vLLM / DeepSeek / 内部模型:
#   OPENAI_BASE_URL=http://your-host:8000/v1
#   NEW_MODEL_ID=your-model-name
OPENAI_BASE_URL=http://127.0.0.1:19090/v1
OPENAI_API_KEY=dummy
NEW_MODEL_ID=newmodel-preview

# --- 内部路径(一般不用改)---
AGYPROXY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MITM_VENV="$HOME/.venvs/mitm"
MITM_CA="$HOME/.mitmproxy/mitmproxy-ca-cert.pem"
